{
  "manifest_version": 3,
  "name": "Site Styler Extension",
  "version": "1.0",
  "description": "Changes the background color of Google and Facebook to red.",
  "permissions": [
    "tabs"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.google.com/*",
        "*://*.facebook.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    }
  ]
}